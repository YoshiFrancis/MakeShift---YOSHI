    "test:audio-browser": "node ../tests/frontend/browserAudio.browser.mjs",
    "test:midi-browser": "node ../tests/frontend/midiExport.browser.mjs",
    "test:performance-browser": "node ../tests/frontend/performanceMetrics.browser.mjs",
